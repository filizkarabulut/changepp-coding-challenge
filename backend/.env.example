# Copy this file to ".env" and fill in your own values.
# The real .env file is git-ignored and must never be committed.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/image-sharing-app
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/image-sharing-app
MONGODB_URI=mongodb://127.0.0.1:27017/image-sharing-app

# Port the API server listens on.
PORT=5000

# Origin of the frontend, used when building share links.
CLIENT_ORIGIN=http://localhost:3000
